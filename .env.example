# Copy to .env and adjust. Backend reads this via pydantic-settings.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/construction_erp
TEST_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/construction_erp_test
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
# Enables the AI copilot + AI inbox; without it those features return 503 ai_not_configured
ANTHROPIC_API_KEY=
# Uploaded ingestion documents are stored here (relative to backend/)
MEDIA_ROOT=media
